# Paste the token for the provider you use after its "=".
# Leave the other lines empty: any text here is sent as a real token,
# and a placeholder makes clones and API calls fail.
GITHUB_TOKEN=
GITLAB_TOKEN=
BITBUCKET_TOKEN=

# Optional: Bitbucket Cloud organization audit access uses separate Atlassian
# admin credentials, not the repository/workspace token above.
ATLASSIAN_ORG_ID=
ATLASSIAN_ADMIN_TOKEN=
